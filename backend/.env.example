# CodeWhisperer Backend Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ─── Application ─────────────────────────────────────────────────────────────
# Environment: development | production
ENVIRONMENT=development
DEBUG=false
# Strong random secret key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# CORS origins (comma-separated or JSON list; include your Vercel frontend URL in production)
ALLOWED_ORIGINS=["http://localhost:5173"]

# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
# asyncpg DSN format: postgresql+asyncpg://user:password@host/dbname?sslmode=require
# Get this from: https://console.neon.tech → your project → Connection string
DATABASE_URL=

# ─── Supabase Auth ────────────────────────────────────────────────────────────
# From: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=
# Publishable key (sb_publishable_...) — safe for client-side use
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) — server-side only, never expose to the browser
SUPABASE_SECRET_KEY=
# No JWT secret needed — token verification uses the JWKS endpoint at
# {SUPABASE_URL}/auth/v1/.well-known/jwks.json (asymmetric key verification)

# ─── GitHub App ───────────────────────────────────────────────────────────────
# Register at: https://github.com/settings/apps/new
# App ID from the app's General settings page
GITHUB_APP_ID=
# App slug (used to construct install URLs)
GITHUB_APP_NAME=
# OAuth client credentials from the app's General page
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Exact public URL registered as the GitHub App callback URL
GITHUB_APP_CALLBACK_URL=http://localhost:8000/api/v1/integrations/github/callback
# Private key — paste the full PEM content (including BEGIN/END lines)
# In production, store this in a secret manager and load it here
GITHUB_APP_PRIVATE_KEY=
# Webhook secret (optional for local dev; required for production webhook endpoints)
GITHUB_APP_WEBHOOK_SECRET=

# ─── Qdrant Cloud ─────────────────────────────────────────────────────────────
# From: https://cloud.qdrant.io → your cluster → Dashboard
QDRANT_URL=
QDRANT_API_KEY=

# ─── Google Gemini (LLM & Embeddings) ────────────────────────────────────────
# From: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Model IDs (defaults shown — override if needed)
GEMINI_MODEL_FAST=gemini-3.8-flash
GEMINI_MODEL_STRONG=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# ─── Cloudflare R2 Object Storage ─────────────────────────────────────────────
# From: https://dash.cloudflare.com → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=codewhisperer
R2_PUBLIC_URL=

# ─── Upstash Redis (optional — do not configure until caching is needed) ──────
REDIS_URL=
